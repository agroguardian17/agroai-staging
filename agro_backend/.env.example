# =============================================================================
# AgroGuardian V2 - Environment Variables (.env.example)
# =============================================================================
# Copy this file to .env (which is gitignored) and fill values where indicated.
# Anything marked [GENERATE] you can produce locally; [FILL] needs an account.
# Anything marked [LATER] is for a future phase and can stay blank in pilot.
# Anything marked [DEV-OK] has a sane local default; you only override in prod.
#
# Quick generators (PowerShell):
#   $bytes = New-Object byte[] 32; (New-Object Random).NextBytes($bytes); [Convert]::ToBase64String($bytes)
# Quick generators (bash):
#   openssl rand -base64 32
# =============================================================================


# ----- App -----------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_VERSION=0.0.1
# CI overrides this; local development reports "dev".
APP_GIT_SHA=dev
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR


# ----- Database (self-hosted Postgres in docker compose) -------------------
# Both URLs point to the same DB; SQLAlchemy uses async, Alembic uses sync.
POSTGRES_USER=agro
POSTGRES_DB=agro
# [GENERATE] 32-byte random; required to start postgres container
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://agro:CHANGE_ME@postgres:5432/agro
DATABASE_URL_SYNC=postgresql://agro:CHANGE_ME@postgres:5432/agro


# ----- Auth ----------------------------------------------------------------
# [GENERATE] 32-byte random base64; rotate quarterly
AUTH_JWT_SECRET=
AUTH_JWT_ACCESS_TTL_SECONDS=900     # 15 min
AUTH_JWT_REFRESH_TTL_SECONDS=2592000  # 30 days
AUTH_JWT_ISSUER=agroguardian
AUTH_JWT_AUDIENCE=agroguardian-app
OTP_TRANSPORT=whatsapp              # whatsapp (pilot) | sms (Phase 13)


# ----- MQTT (self-hosted Mosquitto) ----------------------------------------
MQTT_BROKER_HOST=mosquitto          # [DEV-OK] hostname inside docker network
# Backend-to-Mosquitto listener inside Docker. Public hardware MQTT/TLS is
# exposed by Caddy on port 8883 in staging/production.
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=service
# [GENERATE] 32-byte random; mirror in deploy/mosquitto/passwd
MQTT_BROKER_PASSWORD=
MQTT_TLS_CA_PATH=/etc/ssl/certs/ca-certificates.crt
MQTT_USE_TLS=false                  # true in production


# ----- ChromaDB ------------------------------------------------------------
CHROMA_HOST=chroma                  # [DEV-OK]
CHROMA_PORT=8000
CHROMA_PERSIST_PATH=/data/chroma


# ----- Anthropic (Claude Sonnet + Haiku) -----------------------------------
# Sign up: https://console.anthropic.com  (add $20 credit to start)
# [FILL] sk-ant-...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-5
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
USD_INR_RATE=83.0


# ----- WhatsApp (Meta Cloud API - both OTP + Advisory) ---------------------
# Sign up: https://developers.facebook.com -> create app -> add WhatsApp product
# Submit BOTH the 'authentication' (OTP) and 'utility' (advisory) templates in
# the same session - both take 24-48h to approve.
# [FILL] from Meta dashboard "Phone numbers"
META_WHATSAPP_PHONE_NUMBER_ID=
# [FILL] WABA id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# [FILL] long-lived (60-day) system user token
META_WHATSAPP_TOKEN=
# [GENERATE] random string; copy into Meta webhook config
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_OTP_TEMPLATE_NAME=agroguardian_otp_v1
META_WHATSAPP_ADVISORY_TEMPLATE_NAME=agroguardian_advisory_v1
META_WHATSAPP_GRAPH_VERSION=v20.0


# ----- Firebase Cloud Messaging (push notifications) ----------------------
# Sign up: https://console.firebase.google.com -> Project Settings -> Service accounts -> generate JSON
FCM_SERVICE_ACCOUNT_JSON_PATH=/secrets/fcm-sa.json   # mount the JSON at this path
# [FILL] firebase project id
FCM_PROJECT_ID=


# ----- Satellite imagery ---------------------------------------------------
# Copernicus Data Space (Sentinel-2): https://dataspace.copernicus.eu (instant)
# [FILL]
COPERNICUS_CLIENT_ID=
# [FILL]
COPERNICUS_CLIENT_SECRET=
COPERNICUS_BASE_URL=https://sh.dataspace.copernicus.eu
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# NASA Earthdata (SMAP): https://urs.earthdata.nasa.gov (24-hour approval)
# [FILL]
NASA_EARTHDATA_USERNAME=
# [FILL]
NASA_EARTHDATA_PASSWORD=


# ----- Weather forecasts (no auth needed) ---------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
IMD_BASE_URL=https://mausam.imd.gov.in/api


# ----- Object storage: Cloudflare R2 (rasters, photos, firmware) ---------
# Sign up: https://dash.cloudflare.com -> R2 -> Create API token
# [FILL] from R2 dashboard
R2_ACCOUNT_ID=
# [FILL]
R2_ACCESS_KEY_ID=
# [FILL]
R2_SECRET_ACCESS_KEY=
# [FILL] https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_BUCKET_RASTERS=agro-rasters
R2_BUCKET_PHOTOS=agro-photos
R2_BUCKET_FIRMWARE=agro-firmware


# ----- Cold backups: Backblaze B2 -----------------------------------------
# Sign up: https://www.backblaze.com/b2 -> create bucket + application key
# [FILL]
B2_KEY_ID=
# [FILL]
B2_APPLICATION_KEY=
# [FILL] https://s3.<region>.backblazeb2.com
B2_ENDPOINT_URL=
B2_BUCKET_BACKUPS=agro-backups


# ----- Monitoring ----------------------------------------------------------
# Sentry: https://sentry.io (free tier)
# [FILL] optional but recommended; leave blank to disable
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Better Stack (logs): https://betterstack.com (free tier)
# [FILL] optional; leave blank to disable HTTP shipping
BETTER_STACK_TOKEN=
BETTER_STACK_INGEST_HOST=in.logs.betterstack.com


# ----- CORS / security ----------------------------------------------------
# Comma-separated list of allowed origins. Use sslip.io hostnames during prototype.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8501,http://localhost:19006
TRUSTED_HOSTS=*


# ----- OTA signing (Phase 8) ----------------------------------------------
# [LATER] base64 ed25519 PEM; generate via scripts/dev/ota_keygen.py
OTA_SIGNING_PRIVATE_KEY_PEM=
# [LATER] base64 ed25519 PEM (also baked into firmware)
OTA_SIGNING_PUBLIC_KEY_PEM=


# ----- Grafana admin (prod only) ------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin        # [GENERATE] override in production


# =============================================================================
# Deferred to Phase 13 (post-pilot SMS via MSG91)
# =============================================================================
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_OTP_DLT_ID=
# MSG91_TEMPLATE_ALERT_DLT_ID=

